# ============================================================
# FRONTEND .env.example  ─  BROWSER CONFIG TEMPLATE
# ============================================================
# Copy this file:
#
#   Development:  cp .env.example .env.development
#   Production:   cp .env.example .env.production
#
# RULES:
#   ✅ ALL browser-exposed variables MUST use NEXT_PUBLIC_ prefix
#   ❌ MUST NOT contain any secrets (JWT, DB, payment keys, etc.)
#   ❌ Production values MUST NOT reference localhost
# ============================================================

# ── GraphQL API ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/graphql
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/graphql

# ── WebSocket (subscriptions) ─────────────────────────────────
NEXT_PUBLIC_WS_URL=ws://localhost:8000/graphql

# ── REST API ─────────────────────────────────────────────────
NEXT_PUBLIC_REST_API_URL=http://localhost:8000/api

# ── Malicc HQ ────────────────────────────────────────────────
NEXT_PUBLIC_HQ_API_URL=http://localhost:3001
